# OpenFilz - Dokploy Environment Configuration
#
# Copy these variables to Dokploy's Environment tab
# Replace 'yourdomain.com' with your actual domain

# =============================================================================
# Domain Configuration (REQUIRED)
# =============================================================================
# Set these to your actual domains (must have DNS A records pointing to Dokploy server)
WEB_HOSTNAME=app.yourdomain.com
API_HOSTNAME=api.yourdomain.com
KEYCLOAK_HOSTNAME=auth.yourdomain.com
ONLYOFFICE_HOSTNAME=docs.yourdomain.com

# =============================================================================
# Database Configuration
# =============================================================================
# compose.yaml already defaults this to pgvector/pgvector:pg17 (a pgvector-enabled
# postgres:17), which is required for AI Document Chat (OPENFILZ_AI_ACTIVE=true).
# Leave commented out unless you need to pin something else — setting this to a
# plain postgres image (e.g. postgres:16) silently disables AI: Flyway's
# V1_4__add_ai_support.sql then fails with "extension \"vector\" is not available".
#POSTGRES_IMAGE=pgvector/pgvector:pg17
DB_NAME=dms_db
DB_USER=dms_user
DB_PASSWORD=change-this-strong-password

# =============================================================================
# API Configuration
# =============================================================================
OPENFILZ_API_IMAGE=ghcr.io/openfilz/openfilz-api:latest
JAVA_OPTS=-Xmx1g -Xms512m

OPENFILZ_INTERNAL_API_BASE_URL=http://openfilz-api:8081
OPENFILZ_PUBLIC_API_BASE_URL=http://localhost:8081

OPENFILZ_SOFT_DELETE=true


# =============================================================================
# Web Configuration
# =============================================================================
OPENFILZ_WEB_IMAGE=ghcr.io/openfilz/openfilz-web:latest

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins (use your actual domains with https://)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://docs.yourdomain.com

# =============================================================================
# Security Configuration (Keycloak)
# =============================================================================
KEYCLOAK_IMAGE=ghcr.io/openfilz/keycloak:26.7
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-admin-password
KEYCLOAK_CLIENT_ID=openfilz-web
# Public URL for Keycloak (used as frontendUrl in realm configuration)
KEYCLOAK_PUBLIC_URL=https://auth.yourdomain.com
# Client root URL for openfilz-web (used in realm import for rootUrl, redirectUris, etc.)
OPENFILZ_WEB_ROOT_URL=https://app.yourdomain.com
# Internal Docker URL for Keycloak realm (used by API for JWK fetching)
KEYCLOAK_REALM_URL=http://keycloak:8080/realms/openfilz
# Keycloak database (auto-created by init-keycloak-db.sh on first postgres startup)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-keycloak-db-password
KEYCLOAK_DB_NAME=keycloak
# Default roles assigned to new users (used in realm import)
# Up to 4 role slots. Available roles: READER, CONTRIBUTOR, AUDITOR, CLEANER, SIGN_REQUESTER
# Set unused slots to an already-used role (duplicates are ignored by Keycloak)
# Example for all permissions: CONTRIBUTOR, AUDITOR, CLEANER, READER
KEYCLOAK_DEFAULT_ROLE_1=READER
KEYCLOAK_DEFAULT_ROLE_2=READER
KEYCLOAK_DEFAULT_ROLE_3=READER
KEYCLOAK_DEFAULT_ROLE_4=READER
# Default groups assigned to new users (used in realm import)
# Up to 4 group slots. Available groups: /OPENFILZ/READER, /OPENFILZ/CONTRIBUTOR, /OPENFILZ/AUDITOR, /OPENFILZ/CLEANER, /OPENFILZ/SIGN_REQUESTER
# Set unused slots to an already-used group (duplicates are ignored by Keycloak)
KEYCLOAK_DEFAULT_GROUP_1=/OPENFILZ/READER
KEYCLOAK_DEFAULT_GROUP_2=/OPENFILZ/READER
KEYCLOAK_DEFAULT_GROUP_3=/OPENFILZ/READER
KEYCLOAK_DEFAULT_GROUP_4=/OPENFILZ/READER

# =============================================================================
# SMTP Configuration (Keycloak + e-Sign emails)
# =============================================================================
# NOTE: openfilz-api reads these too (e-Sign invitations, reminders, OTP codes). The
# placeholder host below is not a real server: replace it, or leave SMTP_HOST empty to
# keep e-Sign in log-only mode instead of failing every send.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@yourdomain.com
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_AUTH=true
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# =============================================================================
# Identity Providers (Social Login)
# =============================================================================
# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Microsoft OAuth2
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# =============================================================================
# OnlyOffice Configuration
# =============================================================================
# IMPORTANT: Change this secret in production!
ONLYOFFICE_JWT_SECRET=change-this-onlyoffice-jwt-secret
# Internal Docker URLs (don't change unless you know what you're doing)
ONLYOFFICE_URL=http://onlyoffice

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage type: local (default) - MinIO not included in this Dokploy setup
STORAGE_TYPE=local

# =============================================================================
# e-Sign electronic signatures (optional)
# =============================================================================
# Master switch. When off, the Signatures menu is hidden and /api/v1/signatures/**
# answers 404. Flipping it needs a full restart: the public signing security chain
# reads it once at startup. Full reference: docs/esign.md
#OPENFILZ_SIGNATURE_ACTIVE=true
# Restrict WHO may initiate signature requests: when true, envelope/template writes also
# require the SIGN_REQUESTER realm role (grant it via KEYCLOAK_DEFAULT_ROLE_x for
# self-registered users, or per user in Keycloak). Off = every CONTRIBUTOR may initiate.
#OPENFILZ_SIGNATURE_REQUIRE_REQUESTER_ROLE=true
# Signing links are built as {base}sign?token=... from OPENFILZ_COMMON_WEBPUBLICBASEURL
# (set above, keep the trailing slash), so point that at your real app hostname.
# Envelope TTL when the create request omits expiresInDays.
#OPENFILZ_SIGNATURE_DEFAULT_EXPIRY_DAYS=30
# Fair-use ceiling for public demo / trial instances: envelopes ONE initiator may create
# per calendar month, 0 = unlimited. Over the limit, POST /signatures answers 429.
#OPENFILZ_SIGNATURE_QUOTA_ENVELOPES_PER_MONTH=0
# --- Mail ---
# e-Sign reuses the SMTP_* settings above (shared with Keycloak). Leave SMTP_HOST empty
# and invitations, reminders and OTP codes are only written to the application log
# ([e-sign][no-smtp] ..., signing link and OTP in clear) instead of being sent - enough to
# try the ceremony, useless for real signers. Recipients set to EMAIL_OTP are then refused
# at envelope creation (422) rather than stranded on a step the server cannot deliver.
#OPENFILZ_SIGNATURE_MAIL_FROM=noreply@yourdomain.com
#OPENFILZ_SIGNATURE_MAIL_FROM_NAME=OpenFilz e-Sign
# --- Seal (the PAdES signature applied once every signer is done) ---
#   self-signed-dev (default) - certificate regenerated in memory at EVERY restart, so
#                               Acrobat reads "validity unknown". Evaluation only.
#   pkcs12                    - your own .p12; mount it into the openfilz-api container
#                               and point KEYSTORE_PATH at the in-container path. Store
#                               and key passwords must be identical.
#   openfilz-cloud            - sign.openfilz.com holds an AATL key; only a hash leaves
#                               your deployment, never document content. Needs an API key.
# A keystore that fails to load is NOT fatal - it falls back to the ephemeral dev seal and
# logs an error, so check the [e-sign] lines after every deployment.
#OPENFILZ_SIGNATURE_SEAL_PROVIDER=pkcs12
#OPENFILZ_SIGNATURE_SEAL_KEYSTORE_PATH=/run/secrets/seal.p12
#OPENFILZ_SIGNATURE_SEAL_KEYSTORE_PASSWORD=
#OPENFILZ_SIGNATURE_SEAL_KEYSTORE_ALIAS=openfilz-seal
#OPENFILZ_SIGNATURE_CLOUD_API_KEY=

# =============================================================================
# AI Document Chat (optional)
# =============================================================================
# Uncomment to enable. Requires POSTGRES_IMAGE above to stay pgvector-enabled
# (it does by default) — Flyway's AI migration needs the `vector` extension.
#OPENFILZ_AI_ACTIVE=true

# --- Local inference via Ollama (self-hosted, no API key needed) ---
# IMPORTANT: compose.yaml activates the ollama/ollama-init services with a
# profile-name-is-the-boolean trick (profiles: ["${OLLAMA_CHAT_ENABLED:-false}", ...]).
# Docker Compose only starts services whose profile is listed in COMPOSE_PROFILES,
# so this variable MUST also be set to "true" — without it, OLLAMA_CHAT_ENABLED/
# OLLAMA_EMBEDDING_ENABLED alone will NOT create the ollama container, and
# openfilz-api will fail to reach it ("ollama: Temporary failure in name
# resolution") even though AI itself is active.
#COMPOSE_PROFILES=true
#OLLAMA_CHAT_ENABLED=true
#OLLAMA_CHAT_MODEL=llama3
#OLLAMA_EMBEDDING_ENABLED=true
#OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# In-process embeddings instead of Ollama's: the API runs nomic-embed-text-v1.5 itself through
# ONNX Runtime — every replica embeds on its own CPUs, nothing else to deploy. Leave
# OLLAMA_EMBEDDING_ENABLED=false when you switch. Changing the embedding provider changes the
# vector space: an existing library must be re-embedded (docs/ai.md §2).
#TRANSFORMERS_EMBEDDING_ENABLED=true
#TRANSFORMERS_EMBEDDING_MODEL=nomic-embed-text-v1.5
#TRANSFORMERS_EMBEDDING_MODEL_URI=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/onnx/model_quantized.onnx
#TRANSFORMERS_EMBEDDING_TOKENIZER_URI=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/tokenizer.json
# Embedding-model change policy: fail-fast (default) refuses to start when the provider/model
# changed while vectors exist; warn starts anyway — needed for the switch until the library is
# re-embedded (TRUNCATE vector_store; DELETE FROM ai_embedding_registry; re-upload or backfill).
#OPENFILZ_AI_EMBEDDING_VALIDATION=fail-fast

# --- Or use a hosted provider instead of/alongside Ollama (no COMPOSE_PROFILES needed) ---
#OPENAI_API_KEY=
#OPENAI_CHAT_ENABLED=true
#OPENAI_EMBEDDING_ENABLED=true
#ANTHROPIC_API_KEY=
#ANTHROPIC_CHAT_ENABLED=true
#GOOGLE_API_KEY=
#GOOGLE_CHAT_ENABLED=true
# Pin the model explicitly — providers retire model ids, and a retired one fails every chat
# with a 404 ("no longer available to new users") until this is updated.
#GOOGLE_CHAT_MODEL=gemini-3.6-flash

# --- Automatic failover between chat models ---
# Free tiers hand out small per-minute/per-day allowances. With this on, a chat that fails
# because the quota is spent (or the model was retired, or the provider is down) is retried
# on the next model in the chain, and the failed model is benched for a cooldown so the
# requests after it skip straight to one that works. A bad API key on the model you chose never
# triggers failover — that surfaces as an error so you fix the key rather than silently answering
# elsewhere. (A key from the pools below is the exception: see AI_FALLBACK_KEYS_* .)
# Entries are 'provider:model' (google|anthropic|openai|openai-compatible), tried in order;
# each needs its API key set above. The active model is tried first and needs no entry.
# A provider named in the chain needs NO <PROVIDER>_CHAT_ENABLED switch, and when no switch is
# set the chain's FIRST entry also becomes the primary chat model — so these two lines are a
# complete chat configuration. Every provider named must have a key: this is checked at startup
# and refuses to boot otherwise (set AI_FALLBACK_VALIDATION=WARN to start with a shorter chain).
# Ignored entirely when the chat provider is Ollama — a local model keeps document content
# in-house, and failing over would send RAG context to a third-party API.
#AI_FALLBACK_ENABLED=true
#AI_FALLBACK_CHAIN=google:gemini-3.6-flash,anthropic:claude-haiku-4-5,openai:gpt-4o-mini
#AI_FALLBACK_VALIDATION=FAIL_FAST
# Several keys per provider, comma-separated and tried in order. Quota is charged per KEY, so
# once every chain model of a provider is spent on the key in use, the next key of that provider
# takes over and those models work again — the cheapest way to widen a free-tier allowance.
# A provider left empty here keeps using its single API key above.
# A pool key the provider REFUSES (401/403) is dropped from rotation for the rest of the process
# and the next key takes over — one bad key must not break chat when you configured several. It is
# logged at ERROR with a short fingerprint of the key so you know which entry to fix; the key is
# not retried until you correct it here and restart.
#AI_FALLBACK_KEYS_GOOGLE=AIza-first-project-key,AIza-second-project-key
#AI_FALLBACK_KEYS_ANTHROPIC=
#AI_FALLBACK_KEYS_OPENAI=
# How long a model is benched after a spent quota / outage (per-minute limits refill fast).
#AI_FALLBACK_QUOTA_COOLDOWN=5m
# How long after a 404 — longer, because a retired model will not come back on its own.
#AI_FALLBACK_UNAVAILABLE_COOLDOWN=6h

# --- Per-user AI settings (BYOK) ---
#AI_USER_SETTINGS_ENABLED=true
# Generate with: openssl rand -base64 32
#AI_SETTINGS_ENCRYPTION_KEY=

# --- Document insights & smart filing on upload (need OPENFILZ_AI_ACTIVE=true) ---
# Insights: a model labels each uploaded file (category from a closed list, summary, keywords,
# language, entities), shown in the details panel and used by the assistant to organise folders.
# Sends up to 6 000 characters of each file to the configured model — keep the model local (Ollama)
# when documents must not leave the deployment. Smart filing additionally needs embeddings: with
# the switch on (or autoFile=true on the upload), the file is moved seconds after the upload to the
# folder where its closest documents live, or stays put when nothing is confident enough.
#OPENFILZ_AI_INSIGHTS_ACTIVE=true
# provider:model for the enrichment, e.g. anthropic:claude-haiku-4-5 (empty = the chat model)
#OPENFILZ_AI_INSIGHTS_MODEL=
#OPENFILZ_AI_INSIGHTS_DAILY_LIMIT=2000
# Parallel model calls for the insights, and documents filed at once by smart filing (each filing
# waits for its document's insight): raise both together when users drop batches of files
#OPENFILZ_AI_INSIGHTS_CONCURRENCY=2
#OPENFILZ_AI_AUTO_FILE_CONCURRENCY=2
#OPENFILZ_AI_AUTO_FILE_ACTIVE=true
# Pre-enable the per-user "Let OpenFilz choose the folder" switch
#OPENFILZ_AI_AUTO_FILE_DEFAULT=false
#OPENFILZ_AI_AUTO_FILE_NEW_FOLDERS=true
# The closed category list (the details panel's kind editor offers it)
#OPENFILZ_AI_INSIGHTS_CATEGORIES=invoice,quote,contract,report,letter,cv,presentation,spreadsheet,form,id-document,receipt,minutes,specification,manual,other
# Who names the category: llm (the chat model, default) | prototype (embedding descriptions, no
# model) | learned (the library's own labelled documents vote, descriptions as cold start, no model)
# | auto (learned, then the model when the confidence is below the threshold). Users correct a
# kind from the details panel; whose labels teach the learned classifier: model,user (add
# prototype,learned to let it feed itself). Measured on a real library: learned 84-88 %,
# descriptions 47 %, a local qwen2.5:1.5b 53 % — run the benchmarks in docs/ai.md §3c on yours.
#OPENFILZ_AI_INSIGHTS_CLASSIFIER=llm
#OPENFILZ_AI_INSIGHTS_CLASSIFIER_MIN_CONFIDENCE=0.5
#OPENFILZ_AI_INSIGHTS_CLASSIFIER_LEARN_FROM=model,user
# Smart filing stage 1: a winning folder must be a home for the document — judged by its files'
# categories (category, default), by their similarity to the document (similarity), or both;
# vote (default) or fit picks the folder. The rule stage files a document of a known kind with no
# home into the scope's folder for that kind (Invoices / Factures / Rechnungen…), found by name in
# any language or created in the language of the existing folders (fallback: default-language).
#OPENFILZ_AI_AUTO_FILE_COHERENCE=category
#OPENFILZ_AI_AUTO_FILE_STAGE1=vote
#OPENFILZ_AI_AUTO_FILE_RULE_FOLDERS=true
#OPENFILZ_AI_AUTO_FILE_DEFAULT_LANGUAGE=en

# =============================================================================
# MCP server (optional)
# =============================================================================
# Exposes the AI assistant's tools to EXTERNAL agents (Claude, Cursor, n8n…) over
# POST /mcp — independent of OPENFILZ_AI_ACTIVE. Discovery uses the public Keycloak
# realm URL (derived from KEYCLOAK_HOSTNAME) and the shared openfilz-mcp PKCE client
# (realms created before the MCP release need it imported by hand — docs/mcp.md).
#OPENFILZ_MCP_ACTIVE=true
# READ_ONLY (default) exposes query/read tools only; raise to READ_WRITE deliberately.
#OPENFILZ_MCP_MODE=READ_ONLY
